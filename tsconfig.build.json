{
  // The shipped bundle, not the tests.
  //
  // ES5, deliberately. 1.3.1's UMD bundle was ES5, and the people this release
  // needs to reach are on toolchains old enough to have installed it. A syntax
  // error in an old parser would replace the message with a different opaque
  // failure, which is the exact thing this release exists to stop.
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "ES2015.Promise", "ES2015.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "importHelpers": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
