{
  "name": "astrologyjs",
  "version": "1.3.2",
  "description": "Retired. astrologyjs 1.x depended on an ephemeris service that no longer exists; use astrologyjs 2.x instead.",
  "main": "dist/astrologyjs.min.js",
  "jsnext:main": "dist/astrologyjs-es6.js",
  "module": "dist/astrologyjs-es6.js",
  "types": "dist/astrologyjs.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morphatic/astrologyjs.git"
  },
  "keywords": [
    "astrology",
    "deprecated"
  ],
  "author": "Morgan Benton <morgan.benton@gmail.com> (http://morphatic.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/morphatic/astrologyjs/issues"
  },
  "homepage": "https://github.com/morphatic/astrologyjs#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.18.8",
    "rollup": "^4.52.4",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
